# Environment variables & secrets
.env
.env.*
*.env
!.env.example
.streamlit/secrets.toml

# Virtual environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Bytecode & Python Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Temporary & transient files
*.tmp
*.temp
*.bak
*.swp
data/**/*.tmp

# Streamlit local runtime settings
.streamlit/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System artifacts
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
._*

# Testing & distribution build artifacts
.pytest_cache/
dist/
build/
*.egg-info/
