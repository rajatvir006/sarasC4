# ==============================================================================
# LUMINA AI STUDIO - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and insert your API keys as needed:
#   Windows PowerShell: Copy-Item .env.example .env
#   Command Prompt:     copy .env.example .env
#
# Note: If no cloud API keys are provided, Lumina AI runs automatically in
# "Smart Local Engine" mode using local neural filters and zero cloud API costs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OpenAI Configuration (Direct)
# ------------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_FAST_VISION_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=dall-e-3

# ------------------------------------------------------------------------------
# 2. Azure OpenAI Configuration (Alternative to direct OpenAI)
# ------------------------------------------------------------------------------
# Obtain from Azure AI Foundry portal (Project Settings -> Endpoints and Keys)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project/openai/v1
AZURE_OPENAI_MODEL=gpt-4.1-mini

# ------------------------------------------------------------------------------
# 3. Google Gemini Configuration
# ------------------------------------------------------------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-flash-latest
